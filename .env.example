# CDP é o padrão: Playwright conecta ao Chrome local aberto pelo usuário na porta 9222.
# Use sempre um perfil dedicado do GRID SOUL; nunca reutilize o perfil pessoal.
# A extensão só é ativada deliberadamente definindo GRID_SOUL_CHATGPT_BRIDGE=extension.
GRID_SOUL_CHATGPT_BRIDGE=cdp

# Porta local do GRID SOUL.
GRID_SOUL_PORT=8765
