.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
secrets/
credentials/
credentials.json
service-account*.json

# Python
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# JavaScript / TypeScript
.npm/
*.tsbuildinfo
.eslintcache

# Builds e artefatos gerados
dist/
build/
out/
coverage/
*.log
logs/
tmp/
temp/

# Editores e sistema operacional
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

